ENV=dev
MONGODB_URI=
# Tiger Data (TimescaleDB): fire replay detections. Optional; without it the fire map uses the same model in memory.
TIGER_DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CLAUDE_FALLBACK_MODEL=claude-sonnet-5-5
CLAUDE_JUDGE_MODEL=claude-opus-5-5
# Claude provider: anthropic (API) or bedrock (Amazon Bedrock)
CLAUDE_PROVIDER=anthropic
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_FALLBACK_MODEL=
BEDROCK_JUDGE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# twilio or sip-trunk (how the number was imported into ElevenLabs)
ELEVENLABS_TELEPHONY=twilio
# voice/ relay: secret ElevenLabs sends to the Custom LLM endpoint
VOICE_LLM_SECRET=
FIRMS_MAP_KEY=
TINYFISH_API_KEY=
# TinyFish zone watcher: free Fetch only. PUBLIC_WEB_URL must be public (TinyFish can't read localhost).
PUBLIC_WEB_URL=
TINYFISH_DAILY_CAP=800
COUNTY_PAGE_URL=
PUBLIC_API_URL=
INTERNAL_TOKEN=
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=*
